{
  "expo": {
    "name": "Calora AI - Nutrition & Health Tracker",
    "slug": "calora-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calora.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "Calora AI requires camera access to scan your meals and barcodes.",
        "NSPhotoLibraryUsageDescription": "Calora AI requires photo library access to analyze food pictures.",
        "NSMotionUsageDescription": "Calora AI uses motion sensors to track your daily steps."
      }
    },
    "android": {
      "package": "com.calora.ai",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Calora AI to access your camera for food & barcode recognition."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Calora AI to access your photos to analyze meal images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "66c4630b-334a-48f9-9cd1-e8009e5db9ee"
      }
    }
  }
}
