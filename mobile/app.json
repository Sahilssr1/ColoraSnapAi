{
  "expo": {
    "name": "SnapCalora AI",
    "slug": "calora-ai",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F9FAFB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calora.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "SnapCalora AI requires camera access to scan your meals and barcodes.",
        "NSPhotoLibraryUsageDescription": "SnapCalora AI requires photo library access to analyze food pictures.",
        "NSMotionUsageDescription": "SnapCalora AI uses motion sensors to track your daily steps."
      }
    },
    "android": {
      "package": "com.calora.ai",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#F9FAFB"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SnapCalora Ai to access your camera for food & barcode recognition."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SnapCalora Ai to access your photos to analyze meal images."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "66c4630b-334a-48f9-9cd1-e8009e5db9ee"
      }
    }
  }
}
