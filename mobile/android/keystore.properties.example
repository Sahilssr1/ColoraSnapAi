# Copy to keystore.properties (gitignored, never commit it) and fill in your
# own values. The keystore file itself must also stay out of git.
# If Play App Signing is ON, you can reset the upload key in Play Console
# instead of reusing a key whose password was ever committed to a repo.
storeFile=release.keystore
storePassword=YOUR_UPLOAD_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
