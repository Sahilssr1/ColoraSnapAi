# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calora_db?schema=public"

# Redis Cache Connection
REDIS_URL="redis://localhost:6379"
REDIS_TTL_SECONDS=3600

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="calora_jwt_access_secret_super_secure_key_2026"
JWT_REFRESH_SECRET="calora_jwt_refresh_secret_super_secure_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# AI Vision API — tried in this order: Groq (gsk_...), Grok (xai-...), Gemini, OpenAI.
# Put real keys in Render env vars (production) or local .env (never committed).
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

GROK_API_KEY="your_grok_api_key_here"
GROK_MODEL="grok-2-vision-1212"

GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

OPENAI_API_KEY="your_openai_api_key_here"

# Google Sign-In — the WEB OAuth client ID from Google Cloud Console
# (APIs & Services > Credentials, type WEB). The backend verifies every
# Google ID token against this value. Without it /auth/google fails
# with a clear configuration error instead of a silent 500.
GOOGLE_WEB_CLIENT_ID="your_web_client_id.apps.googleusercontent.com"

# Food Data APIs
USDA_API_KEY="DEMO_KEY"
OPENFOODFACTS_BASE_URL="https://world.openfoodfacts.org/api/v2"

# File Uploads & Storage
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
